# PostgreSQL
POSTGRES_DB=taxi
POSTGRES_USER=taxi_user
POSTGRES_PASSWORD=taxi_password
POSTGRES_PORT=5432
POSTGRES_HOST=localhost

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_SECRET=change-me-in-production-this-must-be-at-least-256-bits-long-secret-key
JWT_EXPIRATION_MS=3600000

# Inter-service URLs (used by trip-service)
USER_SERVICE_URL=http://localhost:8081
NOTIFICATION_SERVICE_URL=http://localhost:8083

# Notification worker pool
NOTIFICATION_WORKER_POOL_SIZE=4
NOTIFICATION_WORKER_POLL_INTERVAL_MS=1000
NOTIFICATION_MAX_ATTEMPTS=3

# Trip pricing
TRIP_TARIFF_RATE=25.0
